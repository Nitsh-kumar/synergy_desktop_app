# ─────────────────────────────────────────────────────────────────
# .env.example — Synergy App environment variable template
#
# IMPORTANT:
#   • Copy this file to .env and fill in real values locally.
#   • NEVER commit .env to version control.
#   • NEVER hardcode secrets (tokens, API keys) in source files.
#   • .env is listed in .gitignore and will not be committed.
# ─────────────────────────────────────────────────────────────────

# Future: Groq API key for anonymized clinical note drafting (Phase 10).
# Rules: send ONLY anonymized clinical notes. Never send patient name,
# phone, address, billing info, or any direct identifier.
GROQ_API_KEY=

# Future: GitHub token for optional deployment scripts.
# Use a fine-grained PAT with minimum required scopes only.
# NEVER set this as private:false or push to public repositories.
GITHUB_TOKEN=
